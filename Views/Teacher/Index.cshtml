@model List<TeacherRecord>
@{
    ViewData["Title"] = "Преподаватели";
    var admin = User.IsInRole("Admin");
}
<h1>Преподаватели</h1>
@if (admin)
{
    <form asp-controller="Teacher" asp-action="Add" method="post" class="inline">
        <input name="name" placeholder="Имя" required />
        <input name="surname" placeholder="Фамилия" required />
        <input name="age" type="number" placeholder="Возраст" required />
        <input name="subject" placeholder="Предмет" required />
        <input name="experience" type="number" placeholder="Стаж" required />
        <button class="btn">Добавить</button>
    </form>
}
<div class="scroll">
    <table class="grid">
        <thead><tr><th>Фамилия</th><th>Имя</th><th>Возраст</th><th>Предмет</th><th>Стаж</th>@if (admin) { <th></th> }</tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Surname</td><td>@t.Name</td><td>@t.Age</td><td>@t.Subject</td><td>@t.Experience</td>
                @if (admin)
                {
                    <td><form asp-controller="Teacher" asp-action="Delete" asp-route-id="@t.Id" method="post"><button class="link danger">Удалить</button></form></td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
